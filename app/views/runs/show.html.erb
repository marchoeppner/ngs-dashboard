<p style="color: green"><%= notice %></p>

<h1>Lauf <%=  @run.name %></h1>
<p>
  <div class="run-section">
    <%= render "tabbed_view", run: @run %>
  </div>
<p>
<% if @jobs.length > 0 %>

<div class="job-section">
  <h2 class="section-with-logo"><%= image_tag "job_icon.png", class: "icon" %><span>Jobs</span></h2>
  <%= render @jobs %>
  <p>
</div>
<% end %>
<p>

<div class="library-selection">
  <h2 class="section-with-logo"><%= image_tag "library_icon.png", class: "icon" %><span>Libraries</span></h2>
  <p>
    <div class="info-text">
  Wählen Sie eine oder mehrere Libraries aus, bestimmen Sie die einzusetzende Pipeline (auf Version achten!) und erstellen Sie einen neuen Analyse-Auftrag ("Job erstellen").
    </div>
  </p>
  <%= render "libraries", run: @run %>
</div>
<p>
<div>
  <%= link_to "Lauf bearbeiten", edit_run_path(@run) %> |
  <%= link_to "Übersicht", runs_path %>

  <%= button_to "Lauf löschen", @run, method: :delete, form: { data: { turbo_confirm: 'Wirklich löschen?' } }%>
</div>
