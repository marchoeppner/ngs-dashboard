<p style="color: green"><%= notice %></p>

<h1>Sequenzierlauf</h1>

<%= render @run %>


<% if @jobs.length > 0 %>

  <h2>Jobs</h2>
  <%= render @jobs %>
<% end %>
<p>

<div class="library-selection">
  <h2>Libraries</h2>
  Wählen Sie eine oder mehrere Libraries aus, bestimmen Sie die einzusetzende Pipeline (auf Version achten!) und erstellen Sie einen neuen Analyse-Auftrag ("job").
  <%= render "libraries", run: @run %>
</div>
<p>
<div>
  <%= link_to "Lauf bearbeiten", edit_run_path(@run) %> |
  <%= link_to "Übersicht", runs_path %>

  <%= button_to "Lauf löschen", @run, method: :delete, form: { data: { turbo_confirm: 'Wirklich löschen?' } }%>
</div>
