<p style="color: green"><%= notice %></p>

<% content_for :title, "Runs" %>

<h1>Sequenzierläufe</h1>

<%= link_to "Neue Läufe suchen", register_runs_path, class: "button-2"  %>


<p>
<table class="run-list">
  <tr>
    <th>Plattform</th>
    <th>Name</th>
    <th>Datum</th>
    <th>Datenmenge</th>
    <th>Fehlerrate</th>
    <th>Libraries</th>
    <% @pipelines.each do |pipe| %>
      <th></th>
    <% end %>
    <th></th>
  </tr>
<div id="runs">
  <% @runs.each do |run| %>
    <tr>
    <td><%= run.platform.name %></td>
    <td><%= run.name %></td>
    <td><%= run.run_date %></td>
    <td><%= run.yield %></td>
    <td><%= run.phix_error %></td>
    <td><%= run.count_unique_libraries %></td>
    <% @pipelines.each do |pipe| %>
      <% job = run.jobs.find {|j| j.pipeline == pipe } %>
      <% if job %>
        <td bgcolor="<%= @color_by_status[job.status]%>"><%= link_to pipe.clean_name, run_path(run) %></td>
      <% else %>
        <td><%= link_to pipe.clean_name, create_job_run_path(run, pipeline_id: pipe.id), method: :post %></td>
      <% end %>
    <% end %>
    <td><%= link_to image_tag("right-arrow_icon.png", alt: "Details"), run %></td>
    </tr>
  <% end %>
</div>
</table>
<p>

<%= paginate @runs %>