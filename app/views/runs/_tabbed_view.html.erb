  <div class="tabs-container">
    <input type="radio" id="tab-1" name="my-tabs" checked>
    <label for="tab-1" class="tab-label">
        Übersicht
    </label>
    <div class="tab-content">
        <%= render @run %>
    </div>

    <input type="radio" id="tab-2" name="my-tabs">
    <label for="tab-2" class="tab-label">
        Metriken
    </label>
    <div class="tab-content">
        <% if @run.qc_json %>
        
        <% else %>
            Noch keine Metriken erfasst
        <% end %>

    </div>

    <input type="radio" id="tab-3" name="my-tabs">
    <label for="tab-3" class="tab-label">
        Jobs (<%= @jobs.length %>)
    </label>

    <div class="tab-content">
        <% if @jobs.length > 0 %>

            <div class="job-section">
                <h2 class="section-with-logo"><%= image_tag "job_icon.png", class: "icon" %><span>Jobs</span></h2>
                <%= render @jobs %>
                <p>
            </div>
        <% end %>
    </div>

  </div>