<%= form_with(model: run) do |form| %>
  <% if run.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(run.errors.count, "error") %> prohibited this run from being saved:</h2>

      <ul>
        <% run.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :platform_id, style: "display: block" %>
    <%= form.text_field :platform_id %>
  </div>

  <div>
    <%= form.label :location, style: "display: block" %>
    <%= form.text_field :location %>
  </div>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :run_date, style: "display: block" %>
    <%= form.date_field :run_date %>
  </div>

  <div>
    <%= form.label :demuxed, style: "display: block" %>
    <%= form.checkbox :demuxed %>
  </div>

  <div>
    <%= form.label :comments, style: "display: block" %>
    <%= form.textarea :comments %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
