<%= form_with(model: pipeline) do |form| %>
  <% if pipeline.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(pipeline.errors.count, "error") %> prohibited this pipeline from being saved:</h2>

      <ul>
        <% pipeline.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :version, style: "display: block" %>
    <%= form.number_field :version, :step => "0.1" %>
  </div>

  <div>
    <%= form.label :template, style: "display: block" %>
    <%= form.text_field :template %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description %>
  </div>

  <div>
    <%= form.label :run_level, style: "display: block" %>
    <%= form.checkbox :run_level %>
  </div>

  <div>
    <%= form.label :samplesheet_format, style: "display: block" %>
    <%= form.textarea :samplesheet_format %>
  </div>

  <div>
    <%= form.label :job_level, style: "display: block" %>
    <%= form.checkbox :job_level %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
