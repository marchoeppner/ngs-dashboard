<p style="color: green"><%= notice %></p>

<% content_for :title, "Pipelines" %>

<h1>Pipelines</h1>

<div id="pipelines">
  <table class="pipeline-list">
    <tr>
      <th>Name</th>
      <th>Version</th>
      <th>Job Level</th>
      <th>Run Level</th>
      <th></th>
    </tr>
  <% @pipelines.each do |pipeline| %>
    <tr>
      <td><%= pipeline.name %></td>
      <td><%= pipeline.version %></td>
      <td><%= pipeline.job_level %></td>
      <td><%= pipeline.run_level %></td>
      <td><%= link_to "Details", pipeline %>
    </tr>
  <% end %>
  </table>
</div>
<p>
<%= link_to "New pipeline", new_pipeline_path %>
