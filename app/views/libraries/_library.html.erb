<ul class="lib" id="<%= dom_id library %>">
  <li>Accession:</strong> <%= library.accession %></li>
  <li>Lane:</strong> <%= library.lane %></li>
  <li>Name:</strong> <%= library.name %></li>
  <li>Platform:</strong> <%= library.platform_id %></li>
  <li>Run:</strong> <%= library.run_id %></li>
