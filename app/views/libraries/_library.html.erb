<div id="<%= dom_id library %>">
  <div>
    <strong>Accession:</strong>
    <%= library.accession %>
  </div>
  <div>
    <strong>Lane:</strong>
    <%= library.lane %>
  </div>
  <div>
    <strong>Name:</strong>
    <%= library.name %>
  </div>

  <div>
    <strong>Platform:</strong>
    <%= library.platform_id %>
  </div>

  <div>
    <strong>Run:</strong>
    <%= library.run_id %>
  </div>

  <div>
    <strong>Read count:</strong>
    <%= library.read_count %>
  </div>

  <div>
    <strong>Read length:</strong>
    <%= library.read_length %>
  </div>

  <div>
    <strong>Q30:</strong>
    <%= library.q30 %>
  </div>

</div>
