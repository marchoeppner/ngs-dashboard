<%= form_with(model: library) do |form| %>
  <% if library.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(library.errors.count, "error") %> prohibited this library from being saved:</h2>

      <ul>
        <% library.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :accession, style: "display: block" %>
    <%= form.text_field :accession %>
  </div>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :platform_id, style: "display: block" %>
    <%= form.text_field :platform_id %>
  </div>

  <div>
    <%= form.label :run_id, style: "display: block" %>
    <%= form.text_field :run_id %>
  </div>

  <div>
    <%= form.label :read_count, style: "display: block" %>
    <%= form.number_field :read_count %>
  </div>

  <div>
    <%= form.label :read_length, style: "display: block" %>
    <%= form.text_field :read_length %>
  </div>

  <div>
    <%= form.label :q30, style: "display: block" %>
    <%= form.text_field :q30 %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
