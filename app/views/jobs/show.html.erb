<p style="color: green"><%= notice %></p>

<%= render @job %>
<% @libraries = @job.libraries %>
<% if @libraries.length > 0 %>
  <% @libraries.each do |lib| %>
    <%= render lib %>
  <% end %>
<% end %>

<div>
  <%= link_to "Edit this job", edit_job_path(@job) %> |
  <%= link_to "Back to jobs", jobs_path %>

  <%= button_to "Destroy this job", @job, method: :delete %>
</div>
