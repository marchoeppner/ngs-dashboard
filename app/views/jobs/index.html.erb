<p style="color: green"><%= notice %></p>

<% content_for :title, "Jobs" %>

<h1>Jobs</h1>

<table class="joblist">
  <tr>
    <th>ID</th>
    <th>Run</th>
    <th>Pipeline</th>
    <th>Erstellt</th>
    <th>Status</th>
    <th>Besitzer</th>
    <th></th>
  </tr>
  <% @jobs.each do |job| %>
    <tr>
      <td><%= job.id %></td>
      <td><%= job.run.name %></td>
      <td><%= job.pipeline.name %></td>
      <td><%= job.created_at %></td>
      <td><%= job.status %></td>
      <td><%= job.user.full_name %></td>
      <td><%= link_to "Show this job", job %></td>
    </tr>
  <% end %>   
</table>
<p>
<%= link_to "New job", new_job_path %>
