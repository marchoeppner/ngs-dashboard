<p style="color: green"><%= notice %></p>

<% content_for :title, "Jobs" %>

<h1>Jobs</h1>

<table class="joblist-table">
  <tr>
    <th>ID</th>
    <th>Run</th>
    <th>Pipeline</th>
    <th>Erstellt</th>
    <th>Status</th>
    <th>Besitzer</th>
    <th></th>
  </tr>
  <% @jobs.each do |job| %>
    <tr data-controller="clickable-row" 
          data-clickable-row-url-value="<%= job_path(job) %>" 
          data-action="click->clickable-row#visit" %>
      <td><%= job.id %></td>
      <td><%= job.run.name %></td>
      <td><%= job.pipeline.name %></td>
      <td><%= job.created_at.strftime("%F") %></td>
      <td bgcolor="<%= @color_by_status[job.status] %>"><%= job.status %></td>
      <td><%= job.user.full_name %></td>
      <td><%= button_to "Löschen", job, method: :delete, class: "button-2", form_class: "button", form: { data: { turbo_confirm: 'Wirklich löschen?' } } %></td>
    </tr>
  <% end %>   
</table>
<p>
<%= paginate @jobs %>