<div id="<%= dom_id job %>">
  <div class="job-list">
  <ul>
    <li><%= job.job_id %></li>
    <li><%= job.pipeline.name %></li>
    <li style="background-color:<%= @color_by_status[job.status] %>"><%= job.status %></li>
    <li><a href="file://<%= job.run_path %>" target="_blank">Ordner</a></li>
    <% if job.report %>
      <li><a href="file://<%= job.report %>" target="_blank">Report</a></li>
    <% end %>
    <li><%= link_to "Details", job %></li>
  </ul>
  </div>
</div>
