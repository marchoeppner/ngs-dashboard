<h1>Dashboard</h1>

<div class="dashboard">

    <div class="dashboard-tile">
        <h2>Sequenzierläufe</h2>
        <p>
        <div>
            <%= image_tag "sequencer_icon.png", class: "dashboard-icon" %><span style=""><%= link_to @runs.length, runs_path %> Läufe registriert</span>
            <p>
            <%= image_tag "analysis_icon.png", class: "dashboard-icon" %><span style=""><%= link_to @jobs.length, jobs_path %> Jobs angelegt</span>

            <p>
                <% if !@runs.empty? %>
                    Aktueller Lauf: <%= link_to "Link", run_path(@runs.first) %>
                <% end %>
        </div>
    </div>


    <div class="dashboard-tile">
        <h2>Sequenzierer</h2>
    </div>

</div>